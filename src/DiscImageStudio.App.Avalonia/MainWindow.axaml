<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscImageStudio.Gui"
        x:Class="DiscImageStudio.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Disc Image Studio (Linux)"
        Width="1120" Height="740">
    <TabControl x:Name="MainTabs" Margin="8">
        <TabItem Header="设计">
            <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="打开图片…" Click="BrowseDesignImage_Click"
                            AutomationProperties.Name="打开设计图片" />
                    <TextBlock Text="{Binding DesignImagePath}" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
                <Border Grid.Row="1" Background="#FF202020" CornerRadius="4"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas x:Name="DesignSurface" Width="480" Height="480" Background="Transparent"
                            PointerPressed="Design_PointerPressed" PointerMoved="Design_PointerMoved"
                            PointerReleased="Design_PointerReleased" PointerWheelChanged="Design_PointerWheelChanged"
                            AutomationProperties.Name="设计画布">
                        <Ellipse Width="480" Height="480" Fill="#FF2B2B2B" IsHitTestVisible="False" />
                        <Ellipse Width="464" Height="464" Canvas.Left="8" Canvas.Top="8" Fill="#FF343434" IsHitTestVisible="False" />
                        <Ellipse Width="192" Height="192" Canvas.Left="144" Canvas.Top="144" Fill="#FF2B2B2B" IsHitTestVisible="False" />
                        <Canvas Width="480" Height="480" IsHitTestVisible="False">
                            <Canvas.Clip>
                                <EllipseGeometry Center="240,240" RadiusX="240" RadiusY="240" />
                            </Canvas.Clip>
                            <Image Source="{Binding DesignBitmap}" Width="{Binding DesignDisplayWidth}"
                                   Height="{Binding DesignDisplayHeight}" Opacity="0.22"
                                   Canvas.Left="{Binding DesignDisplayLeft}" Canvas.Top="{Binding DesignDisplayTop}"
                                   RenderTransformOrigin="50%,50%">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{Binding DesignRotationDeg}" />
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                        <Canvas Width="480" Height="480" IsHitTestVisible="False">
                            <Canvas.Clip>
                                <CombinedGeometry GeometryCombineMode="Exclude">
                                    <CombinedGeometry.Geometry1>
                                        <EllipseGeometry Center="240,240" RadiusX="232" RadiusY="232" />
                                    </CombinedGeometry.Geometry1>
                                    <CombinedGeometry.Geometry2>
                                        <EllipseGeometry Center="240,240" RadiusX="96" RadiusY="96" />
                                    </CombinedGeometry.Geometry2>
                                </CombinedGeometry>
                            </Canvas.Clip>
                            <Image Source="{Binding DesignBitmap}" Width="{Binding DesignDisplayWidth}"
                                   Height="{Binding DesignDisplayHeight}"
                                   Canvas.Left="{Binding DesignDisplayLeft}" Canvas.Top="{Binding DesignDisplayTop}"
                                   RenderTransformOrigin="50%,50%">
                                <Image.RenderTransform>
                                    <RotateTransform Angle="{Binding DesignRotationDeg}" />
                                </Image.RenderTransform>
                            </Image>
                        </Canvas>
                        <Ellipse Width="464" Height="464" Canvas.Left="8" Canvas.Top="8"
                                 Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False" />
                        <Ellipse Width="192" Height="192" Canvas.Left="144" Canvas.Top="144"
                                 Stroke="#66FFFFFF" StrokeThickness="1" StrokeDashArray="4,3" IsHitTestVisible="False" />
                        <Ellipse Width="60" Height="60" Canvas.Left="210" Canvas.Top="210"
                                 Stroke="#99FFFFFF" StrokeThickness="1" IsHitTestVisible="False" />
                    </Canvas>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,170,Auto,170,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Text="缩放" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" Minimum="10" Maximum="400" Value="{Binding DesignScalePercent}"
                            AutomationProperties.Name="设计缩放" />
                    <TextBlock Grid.Column="2" Text="旋转°" VerticalAlignment="Center" />
                    <Slider Grid.Column="3" Minimum="-180" Maximum="180" Value="{Binding DesignRotationDeg}"
                            AutomationProperties.Name="设计旋转" />
                    <Button Grid.Column="4" Content="居中重置" Command="{Binding ResetDesignCommand}" />
                    <Button Grid.Column="5" Content="铺满盘面" Command="{Binding FitDesignCommand}" />
                    <Button Grid.Column="6" Content="导出并送去生成" Click="ExportDesign_Click"
                            AutomationProperties.Name="导出设计图" />
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="生成">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="源图像" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ImagePath}"
                             AutomationProperties.Name="源图像路径" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseImage_Click"
                            AutomationProperties.Name="选择源图像" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="盘型" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{Binding DiscTypeIndex}" Width="160"
                              AutomationProperties.Name="盘型选择">
                        <ComboBoxItem Content="CD" />
                        <ComboBoxItem Content="DVD" />
                        <ComboBoxItem Content="Blu-ray" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsCd}">
                        <TextBlock Text="输出 WAV" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CdOutput}"
                                 AutomationProperties.Name="CD 输出路径" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,140,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsDvd}">
                        <TextBlock Text="总扇区" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DvdSectors}"
                                 AutomationProperties.Name="DVD 总扇区数" />
                        <TextBlock Grid.Column="2" Text="输出 ISO" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding DvdOutput}"
                                 AutomationProperties.Name="DVD 输出路径" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,200,Auto,200,Auto" ColumnSpacing="8" IsVisible="{Binding IsDvd}">
                        <TextBlock Text="抖动强度" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DvdToneDitherPercent}"
                                AutomationProperties.Name="DVD 抖动强度" />
                        <TextBlock Grid.Column="2" Text="亮度" VerticalAlignment="Center" />
                        <Slider Grid.Column="3" Minimum="-64" Maximum="64" Value="{Binding DvdToneBrightness}"
                                AutomationProperties.Name="DVD 亮度调整" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Opacity="0.7"
                                   Text="图太淡就把亮度往负调" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,140,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsBd}">
                        <TextBlock Text="总扇区" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding BdSectors}"
                                 AutomationProperties.Name="BD 总扇区数" />
                        <TextBlock Grid.Column="2" Text="输出 ISO" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding BdOutput}"
                                 AutomationProperties.Name="BD 输出路径" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="开始生成" Command="{Binding GenerateCommand}"
                            AutomationProperties.Name="开始生成" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsBusy}" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="180"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Row="4" Text="{Binding LogText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         AutomationProperties.Name="生成日志" />
                <TextBlock Grid.Row="5" Text="输出框里是绝对路径，生成物就在那里；生成成功后会自动填入刻录页的源文件。"
                           Opacity="0.7" />
            </Grid>
        </TabItem>

        <TabItem Header="预览">
            <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="内半径 mm" VerticalAlignment="Center" />
                    <TextBox Text="{Binding InnerRadiusMm}" Width="70"
                             AutomationProperties.Name="预览内半径" />
                    <TextBlock Text="外半径 mm" VerticalAlignment="Center" />
                    <TextBox Text="{Binding OuterRadiusMm}" Width="70"
                             AutomationProperties.Name="预览外半径" />
                    <Button Content="渲染读回预览" Command="{Binding RenderPreviewCommand}"
                            AutomationProperties.Name="渲染读回预览" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="源图" />
                        <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="读回模拟" />
                        <Image Source="{Binding ResultPreview}" Stretch="Uniform" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="刻录">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="光驱" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DriveItems}"
                              SelectedIndex="{Binding SelectedDriveIndex}"
                              AutomationProperties.Name="刻录设备" />
                    <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshDrivesCommand}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="镜像" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding BurnSource}"
                             AutomationProperties.Name="刻录源文件" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseBurnSource_Click"
                            AutomationProperties.Name="选择刻录源文件" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="先擦除（--blank）" IsChecked="{Binding BurnBlank}" />
                    <CheckBox Content="刻后校验（仅 ISO）" IsChecked="{Binding BurnVerify}" />
                    <CheckBox Content="实刻（不勾选只干跑）" IsChecked="{Binding BurnReallyWrite}"
                              AutomationProperties.Name="实刻开关" />
                    <Button Content="执行" Command="{Binding BurnCommand}"
                            AutomationProperties.Name="执行刻录" />
                </StackPanel>
                <TextBox Grid.Row="3" Text="{Binding BurnLogText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         AutomationProperties.Name="刻录日志" />
                <TextBlock Grid.Row="4" Text="刻录外挂 xorriso / cdrdao；介质非空白且未勾选擦除时会被拒绝写入。"
                           Opacity="0.7" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
