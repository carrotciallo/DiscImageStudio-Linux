<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DiscImageStudio.Gui"
        x:Class="DiscImageStudio.Gui.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Disc Image Studio (Linux)"
        Width="1120" Height="740">
    <TabControl Margin="8">
        <TabItem Header="生成">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="10">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="源图像" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding ImagePath}"
                             AutomationProperties.Name="源图像路径" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseImage_Click"
                            AutomationProperties.Name="选择源图像" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="盘型" VerticalAlignment="Center" />
                    <ComboBox SelectedIndex="{Binding DiscTypeIndex}" Width="160"
                              AutomationProperties.Name="盘型选择">
                        <ComboBoxItem Content="CD" />
                        <ComboBoxItem Content="DVD" />
                        <ComboBoxItem Content="Blu-ray" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsCd}">
                        <TextBlock Text="输出 WAV" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding CdOutput}"
                                 AutomationProperties.Name="CD 输出路径" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,140,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsDvd}">
                        <TextBlock Text="总扇区" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding DvdSectors}"
                                 AutomationProperties.Name="DVD 总扇区数" />
                        <TextBlock Grid.Column="2" Text="输出 ISO" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding DvdOutput}"
                                 AutomationProperties.Name="DVD 输出路径" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,140,Auto,*" ColumnSpacing="8" IsVisible="{Binding IsBd}">
                        <TextBlock Text="总扇区" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding BdSectors}"
                                 AutomationProperties.Name="BD 总扇区数" />
                        <TextBlock Grid.Column="2" Text="输出 ISO" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding BdOutput}"
                                 AutomationProperties.Name="BD 输出路径" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button Content="开始生成" Command="{Binding GenerateCommand}"
                            AutomationProperties.Name="开始生成" />
                    <Button Content="取消" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsBusy}" />
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="180"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBox Grid.Row="4" Text="{Binding LogText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         AutomationProperties.Name="生成日志" />
                <TextBlock Grid.Row="5" Text="生成的 ISO / WAV 与本程序位于同一工作目录（相对路径按当前目录解析）。"
                           Opacity="0.7" />
            </Grid>
        </TabItem>

        <TabItem Header="预览">
            <Grid RowDefinitions="Auto,*" Margin="8" RowSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="内半径 mm" VerticalAlignment="Center" />
                    <TextBox Text="{Binding InnerRadiusMm}" Width="70"
                             AutomationProperties.Name="预览内半径" />
                    <TextBlock Text="外半径 mm" VerticalAlignment="Center" />
                    <TextBox Text="{Binding OuterRadiusMm}" Width="70"
                             AutomationProperties.Name="预览外半径" />
                    <Button Content="渲染读回预览" Command="{Binding RenderPreviewCommand}"
                            AutomationProperties.Name="渲染读回预览" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Spacing="6">
                        <TextBlock Text="源图" />
                        <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="读回模拟" />
                        <Image Source="{Binding ResultPreview}" Stretch="Uniform" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="刻录">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="8" RowSpacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="光驱" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DriveItems}"
                              SelectedIndex="{Binding SelectedDriveIndex}"
                              AutomationProperties.Name="刻录设备" />
                    <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshDrivesCommand}" />
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="镜像" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding BurnSource}"
                             AutomationProperties.Name="刻录源文件" />
                    <Button Grid.Column="2" Content="浏览…" Click="BrowseBurnSource_Click"
                            AutomationProperties.Name="选择刻录源文件" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="先擦除（--blank）" IsChecked="{Binding BurnBlank}" />
                    <CheckBox Content="刻后校验（仅 ISO）" IsChecked="{Binding BurnVerify}" />
                    <CheckBox Content="实刻（不勾选只干跑）" IsChecked="{Binding BurnReallyWrite}"
                              AutomationProperties.Name="实刻开关" />
                    <Button Content="执行" Command="{Binding BurnCommand}"
                            AutomationProperties.Name="执行刻录" />
                </StackPanel>
                <TextBox Grid.Row="3" Text="{Binding BurnLogText}" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         AutomationProperties.Name="刻录日志" />
                <TextBlock Grid.Row="4" Text="刻录外挂 xorriso / cdrdao；介质非空白且未勾选擦除时会被拒绝写入。"
                           Opacity="0.7" />
            </Grid>
        </TabItem>
    </TabControl>
</Window>
